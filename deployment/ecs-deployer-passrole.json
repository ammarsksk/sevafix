{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassSevaFixEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::851725360556:role/ecsTaskExecutionRole",
        "arn:aws:iam::851725360556:role/ecsInfrastructureRoleForExpressServices"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "ecs.amazonaws.com"
          ]
        }
      }
    }
  ]
}
