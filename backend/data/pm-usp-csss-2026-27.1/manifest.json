  "claims": [
    {"claimId": "fresh-percentile", "summary": "Fresh applicant is above the 80th percentile in the relevant Class XII board stream.", "sourceId": "pmusp-csss-faq-2025-26", "page": 1, "section": "FAQ 1"},
    {"claimId": "fresh-regular-degree", "summary": "Fresh applicant pursues a regular degree course; distance, correspondence, and diploma study are excluded.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(ii)"},
    {"claimId": "income-cap", "summary": "Gross parental/family income is no more than INR 450,000 per year; income certificate is required for fresh applicants.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(v)"},
    {"claimId": "other-scholarship", "summary": "Applicant must not receive a conflicting scholarship, fee waiver, or reimbursement.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(iv)"},
    {"claimId": "fresh-no-drop", "summary": "The 2025-26 FAQ excludes fresh applicants who took a drop after Class XII.", "sourceId": "pmusp-csss-faq-2025-26", "page": 1, "section": "FAQ 1"},
    {"claimId": "recognized-institution", "summary": "Course and institution must be recognized by the relevant regulatory body; AISHE status/code matters.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(iii), 4(vi)"},
    {"claimId": "renewal-marks-attendance", "summary": "Renewal requires at least 50 percent marks and at least 75 percent attendance.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(viii)"},
    {"claimId": "duration", "summary": "Scholarship duration does not exceed five years, with course-specific limits.", "sourceId": "pmusp-csss-faq-2025-26", "page": 2, "section": "FAQ 5"},
    {"claimId": "fresh-documents", "summary": "Fresh applicants upload Class XII marksheet and family income certificate, plus category/disability evidence when applicable.", "sourceId": "pmusp-csss-faq-2025-26", "page": 6, "section": "FAQ 19"},
    {"claimId": "renewal-documents", "summary": "Renewal applicants upload the previous-year marksheet.", "sourceId": "pmusp-csss-faq-2025-26", "page": 6, "section": "FAQ 19"},
    {"claimId": "application-route", "summary": "Applications are submitted online through NSP and not directly to the Ministry.", "sourceId": "pmusp-csss-guidelines", "page": 2, "section": "Eligibility 4(ix)"},
    {"claimId": "deadline-conflict", "summary": "Two live NSP pages displayed different renewal closing dates on 2026-09-19, so the deadline is not executable until reviewed.", "sourceId": "nsp-scheme-list-2026-27", "section": "PM-USP CSSS scheme card; cross-check nsp-announcements-2026-27"}
  ],
  "rules": [
    {"ruleId": "fresh-family-income-cap", "title": "Fresh applicant family income must not exceed INR 4.5 lakh", "severity": "BLOCKING", "requiredEvidence": ["INCOME_CERTIFICATE"], "appliesWhen": {"field": "application.type", "op": "EQ", "value": "FRESH"}, "assert": {"field": "student.familyAnnualIncomeINR", "op": "LTE", "value": 450000}, "messageKey": "income_cap", "sourceRefs": ["pmusp-csss-guidelines"]},
    {"ruleId": "regular-course", "title": "Course must be regular, not distance or correspondence", "severity": "BLOCKING", "requiredEvidence": ["ADMISSION_LETTER"], "assert": {"field": "student.enrolmentMode", "op": "EQ", "value": "REGULAR"}, "messageKey": "regular_course", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "not-diploma", "title": "Diploma courses are not eligible", "severity": "BLOCKING", "assert": {"field": "student.courseType", "op": "NOT_IN", "value": ["DIPLOMA"]}, "messageKey": "not_diploma", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "no-conflicting-scholarship", "title": "Applicant must not receive a conflicting scholarship or fee reimbursement", "severity": "BLOCKING", "assert": {"field": "student.receivesOtherScholarship", "op": "EQ", "value": false}, "messageKey": "no_other_scholarship", "sourceRefs": ["pmusp-csss-guidelines"]},
    {"ruleId": "fresh-board-percentile", "title": "Fresh applicant must be above the 80th percentile", "severity": "BLOCKING", "requiredEvidence": ["MARKSHEET"], "appliesWhen": {"field": "application.type", "op": "EQ", "value": "FRESH"}, "assert": {"field": "student.boardPercentile", "op": "GT", "value": 80}, "messageKey": "board_percentile", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "fresh-no-academic-gap", "title": "Fresh applicant must not have taken a drop after Class XII", "severity": "BLOCKING", "appliesWhen": {"field": "application.type", "op": "EQ", "value": "FRESH"}, "assert": {"field": "student.hasAcademicGap", "op": "EQ", "value": false}, "messageKey": "academic_gap", "sourceRefs": ["pmusp-csss-faq-2025-26"]},
    {"ruleId": "fresh-first-year", "title": "Fresh applicant must be in first year of the degree course", "severity": "BLOCKING", "appliesWhen": {"field": "application.type", "op": "EQ", "value": "FRESH"}, "assert": {"field": "student.courseYear", "op": "EQ", "value": 1}, "messageKey": "fresh_first_year", "sourceRefs": ["pmusp-csss-faq-2025-26"]},
    {"ruleId": "recognized-institution", "title": "Institution must be recognized by the relevant regulatory body", "severity": "BLOCKING", "requiredEvidence": ["ADMISSION_LETTER"], "assert": {"field": "institution.recognized", "op": "EQ", "value": true}, "messageKey": "recognized_institution", "sourceRefs": ["pmusp-csss-guidelines"]},
    {"ruleId": "active-aishe-institution", "title": "Institution must have an active AISHE record", "severity": "BLOCKING", "requiredEvidence": ["ADMISSION_LETTER"], "assert": {"field": "institution.aisheActive", "op": "EQ", "value": true}, "messageKey": "active_aishe", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "otr-ready", "title": "NSP One-Time Registration must be ready", "severity": "BLOCKING", "assert": {"field": "student.hasOtr", "op": "EQ", "value": true}, "messageKey": "otr_ready", "sourceRefs": ["pmusp-csss-faq-2025-26", "nsp-announcements-2026-27"]},
    {"ruleId": "name-consistency", "title": "Applicant name should match uploaded identity evidence", "severity": "BLOCKING", "requiredEvidence": ["IDENTITY_PROOF"], "assert": {"field": "student.primaryName", "op": "NAME_SIMILAR", "otherField": "document.primaryName"}, "messageKey": "name_consistency", "sourceRefs": ["pmusp-csss-faq-2025-26"]},
    {"ruleId": "renewal-previous-beneficiary", "title": "Renewal applicant must be an existing PM-USP CSSS beneficiary", "severity": "BLOCKING", "appliesWhen": {"field": "application.type", "op": "EQ", "value": "RENEWAL"}, "assert": {"field": "student.receivedFreshScholarship", "op": "EQ", "value": true}, "messageKey": "renewal_beneficiary", "sourceRefs": ["pmusp-csss-faq-2025-26"]},
    {"ruleId": "renewal-minimum-marks", "title": "Renewal requires at least 50 percent marks", "severity": "BLOCKING", "requiredEvidence": ["PREVIOUS_YEAR_MARKSHEET"], "appliesWhen": {"field": "application.type", "op": "EQ", "value": "RENEWAL"}, "assert": {"field": "student.previousYearMarksPercent", "op": "GTE", "value": 50}, "messageKey": "renewal_marks", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "renewal-minimum-attendance", "title": "Renewal requires at least 75 percent attendance", "severity": "BLOCKING", "requiredEvidence": ["ATTENDANCE_CERTIFICATE"], "appliesWhen": {"field": "application.type", "op": "EQ", "value": "RENEWAL"}, "assert": {"field": "student.attendancePercent", "op": "GTE", "value": 75}, "messageKey": "renewal_attendance", "sourceRefs": ["pmusp-csss-guidelines", "pmusp-csss-faq-2025-26"]},
    {"ruleId": "renewal-duration", "title": "Scholarship duration must not exceed five years", "severity": "BLOCKING", "appliesWhen": {"field": "application.type", "op": "EQ", "value": "RENEWAL"}, "assert": {"field": "student.scholarshipYear", "op": "LTE", "value": 5}, "messageKey": "renewal_duration", "sourceRefs": ["pmusp-csss-faq-2025-26"]},
    {"ruleId": "dbt-bank-readiness", "title": "Bank account should be ready for official DBT requirements", "severity": "ADVISORY", "assert": {"field": "student.bankAadhaarSeeded", "op": "EQ", "value": true}, "messageKey": "dbt_readiness", "sourceRefs": ["pmusp-csss-faq-2025-26"]}
  ],
