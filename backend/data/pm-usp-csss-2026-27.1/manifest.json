      "note": "The NSP scheme card and announcement page showed different renewal closing dates; no deadline rule is executable until reviewed."
    },
    "formSchema": {
      "version": "1.0.0",
      "sections": [
        {
          "id": "application",
          "title": "Application type",
          "fields": [
            {"key": "application.type", "label": "Application type", "type": "select", "required": true, "options": ["FRESH", "RENEWAL"]}
          ]
        },
        {
          "id": "student",
          "title": "Student details",
          "fields": [
            {"key": "student.primaryName", "label": "Name as on Class XII marksheet", "type": "text", "required": true},
            {"key": "student.familyAnnualIncomeINR", "label": "Gross annual family income (INR)", "type": "integer", "requiredFor": ["FRESH"], "minimum": 0},
            {"key": "student.boardPercentile", "label": "Class XII board percentile", "type": "number", "requiredFor": ["FRESH"], "minimum": 0, "maximum": 100},
            {"key": "student.hasAcademicGap", "label": "Took a drop after Class XII", "type": "boolean", "requiredFor": ["FRESH"]},
            {"key": "student.receivesOtherScholarship", "label": "Receiving another scholarship, fee waiver, or reimbursement", "type": "boolean", "required": true},
            {"key": "student.hasOtr", "label": "NSP One-Time Registration is ready", "type": "boolean", "required": true},
            {"key": "student.category", "label": "Category", "type": "select", "required": true, "options": ["GENERAL", "OBC", "SC", "ST", "OTHER"]},
            {"key": "student.hasBenchmarkDisability", "label": "Claiming benchmark-disability reservation", "type": "boolean", "required": true},
            {"key": "student.disabilityPercentage", "label": "Disability percentage", "type": "number", "minimum": 0, "maximum": 100},
            {"key": "student.previousYearMarksPercent", "label": "Previous annual examination marks (%)", "type": "number", "requiredFor": ["RENEWAL"], "minimum": 0, "maximum": 100},
            {"key": "student.attendancePercent", "label": "Previous-year attendance (%)", "type": "number", "requiredFor": ["RENEWAL"], "minimum": 0, "maximum": 100},
            {"key": "student.receivedFreshScholarship", "label": "Previously selected as a PM-USP CSSS beneficiary", "type": "boolean", "requiredFor": ["RENEWAL"]},
            {"key": "student.scholarshipYear", "label": "Current scholarship year", "type": "integer", "requiredFor": ["RENEWAL"], "minimum": 2, "maximum": 5},
            {"key": "student.bankAadhaarSeeded", "label": "Bank account is ready for DBT as required by official guidance", "type": "boolean", "required": true, "sensitiveValuePolicy": "Store only yes/no; never store Aadhaar or bank-account number."}
          ]
        },
        {
          "id": "course",
          "title": "Course and institution",
          "fields": [
            {"key": "student.enrolmentMode", "label": "Enrolment mode", "type": "select", "required": true, "options": ["REGULAR", "DISTANCE", "CORRESPONDENCE"]},
            {"key": "student.courseType", "label": "Course type", "type": "select", "required": true, "options": ["DEGREE", "BTECH_BE", "PROFESSIONAL_INTEGRATED", "POSTGRADUATE", "DIPLOMA"]},
            {"key": "student.courseYear", "label": "Current course year", "type": "integer", "required": true, "minimum": 1, "maximum": 5},
            {"key": "institution.name", "label": "Institution name", "type": "text", "required": true},
            {"key": "institution.aisheCode", "label": "AISHE code", "type": "text", "required": true},
            {"key": "institution.recognized", "label": "Recognized by the relevant regulatory body", "type": "boolean", "required": true},
            {"key": "institution.aisheActive", "label": "Institution status is active on AISHE", "type": "boolean", "required": true}
          ]
        }
      ]
    },
    "documentChecklist": {
      "FRESH": [
        {"documentType": "MARKSHEET", "label": "Class XII marksheet", "required": true},
        {"documentType": "INCOME_CERTIFICATE", "label": "Family income certificate", "required": true},
        {"documentType": "CATEGORY_CERTIFICATE", "label": "Category/caste certificate", "requiredWhen": "student.category != GENERAL"},
        {"documentType": "DISABILITY_CERTIFICATE", "label": "Disability certificate", "requiredWhen": "student.hasBenchmarkDisability == true"},
        {"documentType": "ADMISSION_LETTER", "label": "Admission/course/institution evidence", "requiredBySevaFix": true},
        {"documentType": "IDENTITY_PROOF", "label": "Identity evidence for consistency check", "requiredBySevaFix": true}
      ],
      "RENEWAL": [
        {"documentType": "PREVIOUS_YEAR_MARKSHEET", "label": "Previous-year marksheet", "required": true},
        {"documentType": "ATTENDANCE_CERTIFICATE", "label": "Attendance evidence", "requiredBySevaFix": true}
      ]
    },
    "benefitSchedule": [
      {"courseStage": "GRADUATION", "years": [1, 2, 3], "amountINRPerYear": 12000},
      {"courseStage": "POSTGRADUATION", "amountINRPerYear": 20000},
      {"courseStage": "PROFESSIONAL_OR_INTEGRATED", "years": [4, 5], "amountINRPerYear": 20000},
      {"courseStage": "BTECH_BE", "years": [1, 2, 3], "amountINRPerYear": 12000},
      {"courseStage": "BTECH_BE", "years": [4], "amountINRPerYear": 20000}
    ]
  },
