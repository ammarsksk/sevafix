    "supportedApplicationTypes": ["FRESH", "RENEWAL"],
    "disclaimer": "SevaFix prepares and checks applications; the official authority decides eligibility, selection, submission status, and payment.",
    "liveWindow": {
      "academicYear": "2026-27",
      "applicationType": "RENEWAL",
      "openedOn": "2026-06-01",
      "candidateClosingDates": ["2026-09-30", "2026-10-31"],
      "verificationState": "CONFLICT_REQUIRES_HUMAN_REVIEW",
